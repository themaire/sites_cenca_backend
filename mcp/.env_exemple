# Copier en .env (jamais commité) puis compléter.

# Connexion PostgreSQL : idéalement le rôle lecture seule (documentation/role_lecture_seule.sql)
DB_HOST=qgisdb2.lizmap.com
DB_PORT=5432
DB_NAME=lizmap_cenca_maps
DB_USER=
DB_PASSWORD=

# Écoute : 127.0.0.1 = cette machine uniquement. IP LAN/VPN du serveur pour l'ouvrir aux collègues.
MCP_HOST=127.0.0.1
MCP_PORT=8891
# Jeton partagé avec le client Claude : openssl rand -hex 32
MCP_API_TOKEN=
# IP/CIDR autorisées, ex. 127.0.0.1,192.168.1.0/24,10.8.0.0/24
ALLOWED_IPS=127.0.0.1

# Limites
MCP_MAX_ROWS=2000
MCP_QUERY_TIMEOUT_MS=30000
MCP_DB_MAX_CONNEXIONS=4
