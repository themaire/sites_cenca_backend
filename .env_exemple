
#Pour le cryptage des mots de passe en base de données
SALT_ROUNDS=0 # Nombre de rounds de sel pour bcrypt

#Pour le JSON Web Token
SECRET_KEY=pagouuuu! # Clé secrète pour le JWT

#Pour la connexion à la base de données
DB_USER=pagou
DB_HOST=pastis
DB_NAME=marseille
DB_PASSWORD=kawashi
DB_PORT=5439

#Clé d'accès pour la route publique /sites/sites_diffusables
DIFFUSION_API_KEY=changeme

# Chatbot (/chat) : serveurs Ollama du LAN par ordre de préférence, séparés par des virgules.
# Chaque question part sur le serveur joignable le moins occupé (conversations en cours) ; à égalité, le premier.
# Modèle propre à un serveur avec « | » (ex. variante légère sur le Raspberry Pi) ; sinon OLLAMA_MODEL.
OLLAMA_URL=http://serveur-ollama:11434,http://raspberry-pi5:11434|gemma4:e2b
OLLAMA_MODEL=gemma4
OLLAMA_NUM_CTX=32768
# Raisonnement préalable des modèles « thinking » (true/false) : lent sur CPU, désactivé par défaut
OLLAMA_THINK=false
# Attente maximale d'une réponse d'Ollama (ms) : sur CPU, lire un long prompt peut dépasser 5 min
OLLAMA_TIMEOUT_MS=900000
# Nombre de questions par conversation ; au-delà, la route répond 413 (ouvrir une nouvelle conversation)
CHAT_QUESTIONS_MAX=10
# Serveur MCP cenca-sites (mcp/) et son jeton (même valeur que MCP_API_TOKEN dans mcp/.env).
# Adresse LAN de l'hôte (= MCP_HOST de mcp/.env) : joignable aussi depuis le conteneur node_app en prod.
MCP_URL=http://192.168.1.50:8891/mcp
MCP_API_TOKEN=
